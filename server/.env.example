# Copie para .env e ajuste.
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
PORT=3333
# URL do frontend (usada no link de recuperação de senha e no CORS)
APP_URL=http://localhost:5173
# CORS_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com

# E-mail (opcional). Sem SMTP, o link de recuperação aparece no log do servidor.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Nexus Manager <no-reply@exemplo.com>"

# Cobrança recorrente (Asaas). Sem chave: modo simulado (dev/DEMO_MODE).
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox
# Token configurado no webhook do Asaas (header asaas-access-token)
# ASAAS_WEBHOOK_TOKEN=
# Dias de teste grátis do plano Profissional no cadastro
TRIAL_DAYS=14
# Envia o resumo semanal de vendas (segunda, 8h de Brasília)
WEEKLY_SUMMARY_ENABLED=true

# Somente demonstração: exibe o link de recuperação na própria tela.
DEMO_MODE=false
