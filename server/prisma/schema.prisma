// Nexus Manager — modelo de dados
// Multi-tenant: toda entidade de negócio pertence a uma Organization.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN   // tudo, inclusive gestão de usuários
  MANAGER // tudo, exceto gestão de usuários
  SELLER  // clientes, vendas, tarefas; produtos só leitura; sem relatórios
}

enum SaleStatus {
  PENDING
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_SLIP
  TRANSFER
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  SALE
  SALE_CANCEL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  customers Customer[]
  products  Product[]
  sales     Sale[]
  tasks     Task[]
  movements StockMovement[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(SELLER)
  active         Boolean  @default(true)
  // Incrementado em logout global / troca de senha: invalida JWTs antigos.
  tokenVersion   Int      @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resetTokens    PasswordResetToken[]
  sales          Sale[]
  assignedTasks  Task[]               @relation("TaskAssignee")
  createdTasks   Task[]               @relation("TaskCreator")
  movements      StockMovement[]

  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 do token; o token em si nunca é salvo
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  document       String?  // CPF ou CNPJ
  company        String?
  address        String?
  city           String?
  state          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]
  tasks        Task[]

  @@index([organizationId, name])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  name           String
  description    String?
  category       String?
  price          Decimal  @db.Decimal(12, 2)
  cost           Decimal  @default(0) @db.Decimal(12, 2)
  stock          Int      @default(0)
  minStock       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]
  movements    StockMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, name])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  productId      String
  userId         String?
  saleId         String?
  type           StockMovementType
  quantity       Int               // positivo = entrada, negativo = saída
  balance        Int               // saldo após o movimento
  reason         String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
}

model Sale {
  id             String        @id @default(cuid())
  organizationId String
  number         Int           // sequencial por organização
  customerId     String?
  userId         String?
  status         SaleStatus    @default(PENDING)
  paymentMethod  PaymentMethod @default(PIX)
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  cost           Decimal       @default(0) @db.Decimal(12, 2) // custo total (CMV) no momento da venda
  notes          String?
  paidAt         DateTime?
  canceledAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        SaleItem[]
  movements    StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  name      String  // snapshot do nome no momento da venda
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @default(0) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  assigneeId     String?
  customerId     String?
  createdById    String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}
